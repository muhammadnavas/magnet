# Copy this file to .env and replace every CHANGE_ME value.
# Generate secrets with: openssl rand -hex 32

ENVIRONMENT=development
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_HEX_CHARACTER_SECRET

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_DATABASE_PASSWORD
POSTGRES_DB=magnet
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_USE_A_STRONG_DATABASE_PASSWORD@db:5432/magnet
REDIS_URL=redis://redis:6379/0

# AI providers (set only the providers you use)
GEMINI_API_KEY=
XAI_API_KEY=
LLM_PROVIDER=gemini

# OAuth credentials: create separate OAuth clients for the relevant integrations.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLASSROOM_REDIRECT_URI=http://localhost:8000/api/v1/classroom/callback
GOOGLE_CLASSROOM_APP_REDIRECT_URI=magnet://classroom/callback

# Google Drive desktop OAuth client used by setup_gdrive_auth.py
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_TOKEN_JSON=

# Optional service configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
MONGODB_URL=
GDRIVE_UPLOAD_FOLDER_ID=
