{
  "expo": {
    "name": "Magnet",
    "slug": "orio",
    "scheme": "orio",
    "owner": "muhammadnavas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.muhammadnavas.orio",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Orio uses the microphone when you choose voice input for notes, AI questions, and tasks.",
        "UIBackgroundModes": [
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.muhammadnavas.orio",
      "versionCode": 4,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#6C63FF",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Magnet Reminder"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Magnet to access photos you choose to save to your knowledge library.",
          "cameraPermission": "Allow Magnet to use your camera to capture knowledge.",
          "microphonePermission": "Allow Magnet to use the microphone for voice input and camera video capture."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Orio to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow Orio to convert your speech into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "./plugins/withMagnetShareIntent",
      "./plugins/withMagnetFinanceNotifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "51fcafb1-c725-42a6-81ce-7e28e23355c9"
      }
    }
  }
}
